{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videoml.org/schemas/effect-config.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "parameters": {
      "type": "object"
    },
    "startFrame": {
      "type": "integer",
      "minimum": 0
    },
    "endFrame": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "id",
    "version",
    "parameters",
    "startFrame",
    "endFrame"
  ],
  "additionalProperties": false
}
