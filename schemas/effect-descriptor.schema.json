{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videoml.org/schemas/effect-descriptor.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "parametersSchema": {
      "type": "object"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "sceneInputs": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "sceneIdParameter",
          "frameParameter"
        ],
        "additionalProperties": false,
        "properties": {
          "sceneIdParameter": {
            "type": "string",
            "pattern": "^(?!(?:__proto__|prototype|constructor)$)[A-Za-z_$][A-Za-z0-9_$]*$"
          },
          "frameParameter": {
            "type": "string",
            "pattern": "^(?!(?:__proto__|prototype|constructor)$)[A-Za-z_$][A-Za-z0-9_$]*$"
          }
        }
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "version",
    "parametersSchema"
  ],
  "additionalProperties": false
}
